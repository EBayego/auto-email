{
  "name": "auto-email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "env:check": "node scripts/check-env.mjs",
    "google:check": "node scripts/check-google.mjs",
    "poc:sample": "tsx scripts/poc-sample.ts",
    "poc:style": "tsx scripts/poc-style.ts",
    "poc:select": "tsx scripts/poc-select.ts",
    "poc:generate": "tsx scripts/poc-generate.ts",
    "poc:draft": "tsx scripts/poc-draft.ts",
    "poc:validate": "tsx scripts/poc-validate.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/test-data-access.mjs",
    "test:changes": "node scripts/check-test-changes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on warning",
    "db:test": "supabase test db --local",
    "db:check": "npm run db:lint && npm run db:test",
    "db:types": "node scripts/generate-db-types.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@next/env": "16.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "html-to-text": "10.0.1",
    "next": "16.4.1",
    "openai": "7.36.0",
    "postal-mime": "4.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
