COMPOSE_PROJECT_NAME=auto-email-prod
APP_IMAGE=ghcr.io/ebayego/auto-email-app@sha256:REPLACE_WITH_RELEASE_DIGEST
OPS_IMAGE=ghcr.io/ebayego/auto-email-ops@sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_BIND_PORT=3087
SECRETS_DIRECTORY=/etc/auto-email-prod
ERASURE_LEDGER_HOST_PATH=/srv/auto-email-prod/erasures
BACKUP_STAGING_HOST_PATH=/srv/auto-email-prod/backup-staging
# required: backup before migrations; deferred: explicitly postpone backups.
BACKUP_MODE=required
# Existing Traefik network on the ebia.cloud VPS.
PROXY_NETWORK_NAME=privnetproxy
